{
  "manifest_version": 3,
  "name": "GitHub Collapse Repo",
  "version": "1.0.0",
  "description": "Collapses the GitHub repository file list into a full-width accordion that expands with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
